{
  "name": "ghidai-health-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/participant-e2e.mjs",
    "test:db": "tsx scripts/check-database.ts test",
    "test:p2": "tsx tests/integration/p2-database.ts",
    "test:p3": "tsx scripts/p3-test-schema.ts && tsx tests/integration/p3-auth.ts",
    "test:p3:outages": "tsx tests/integration/p3-outages.ts",
    "db:migrate:p3:dev": "tsx scripts/p3-setup.ts development",
    "db:migrate:p3:test": "tsx scripts/p3-setup.ts test",
    "mail:retry": "tsx scripts/p3-mail.ts",
    "db:migrate:dev": "tsx scripts/p2-database.ts development",
    "db:migrate:test": "tsx scripts/p2-database.ts test",
    "db:check": "tsx scripts/check-database.ts development",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "env:init": "node scripts/init-env.mjs",
    "db:up": "docker compose --env-file .env.development.local up -d --wait",
    "db:stop": "docker compose --env-file .env.development.local stop",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:p4": "tsx scripts/p4-test-schema.ts && tsx tests/integration/p4-programs.ts",
    "test:p5": "tsx scripts/participant-test-schema.ts 5 && tsx tests/integration/p5-participation.ts",
    "test:p6": "tsx scripts/participant-test-schema.ts 6 && tsx tests/integration/p6-tracking.ts",
    "test:p7": "tsx scripts/participant-test-schema.ts 7 && tsx tests/integration/p7-analytics.ts",
    "db:migrate:participant:dev": "tsx scripts/participant-setup.ts development",
    "db:migrate:participant:test": "tsx scripts/participant-setup.ts test",
    "test:participant:outages": "tsx tests/integration/participant-outages.ts",
    "db:migrate:p4:dev": "tsx scripts/p4-setup.ts development",
    "db:migrate:p4:test": "tsx scripts/p4-setup.ts test",
    "audit:p4": "node scripts/p4-audit.mjs",
    "fixtures:p4:dev": "tsx scripts/p4-local-fixtures.ts development",
    "sources:p4:dev": "tsx scripts/p4-import-sources.ts development"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
