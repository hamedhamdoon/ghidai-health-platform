model AccessGrant {
  id                                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime        @default(now()) @db.Timestamptz(6)
  revision                           Int             @default(1)
  subjectId                          String          @db.Uuid
  scopeUserId                        String          @db.Uuid
  resource                           String
  action                             GrantAction
  assignmentId                       String          @db.Uuid
  consentId                          String          @db.Uuid
  startsAt                           DateTime        @db.Timestamptz(6)
  expiresAt                          DateTime        @db.Timestamptz(6)
  revokedAt                          DateTime?       @db.Timestamptz(6)
  reason                             String          @db.VarChar(500)
  grantedBy                          String          @db.Uuid
  CoachAssignment                    CoachAssignment @relation(fields: [assignmentId, scopeUserId, subjectId, consentId], references: [id, userId, coachId, consentId], onUpdate: NoAction)
  User_AccessGrant_grantedByToUser   User            @relation("AccessGrant_grantedByToUser", fields: [grantedBy], references: [id], onUpdate: NoAction)
  User_AccessGrant_scopeUserIdToUser User            @relation("AccessGrant_scopeUserIdToUser", fields: [scopeUserId], references: [id], onUpdate: NoAction)
  User_AccessGrant_subjectIdToUser   User            @relation("AccessGrant_subjectIdToUser", fields: [subjectId], references: [id], onUpdate: NoAction)

  @@unique([subjectId, scopeUserId, resource, action, assignmentId], map: "grant_active", where: raw("(\"revokedAt\" IS NULL)"))
  @@index([assignmentId], map: "AccessGrant_assignmentId_scopeUserId_subjectId_consentId_fkey_i")
  @@index([grantedBy], map: "AccessGrant_grantedBy_fkey_idx")
  @@index([scopeUserId], map: "AccessGrant_scopeUserId_fkey_idx")
  @@index([subjectId], map: "AccessGrant_subjectId_fkey_idx")
}

